<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidateTarkovInstall">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>Softwyx.CareerLog</RootNamespace>
        <AssemblyName>Softwyx.CareerLog</AssemblyName>
        <Company>https://softwyx.com</Company>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <Configurations>Debug;Release;Package</Configurations>
        <!-- Patch is auto-incremented on each build (see scripts/IncrementVersion.ps1). Edit major/minor here. -->
        <Version>1.0.536</Version>
        <!-- Set -p:IncrementVersionOnBuild=false to skip auto-bump (e.g. rebuild without changing version). -->
        <IncrementVersionOnBuild Condition="'$(IncrementVersionOnBuild)' == ''">true</IncrementVersionOnBuild>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <Deterministic>true</Deterministic>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <!-- Set true in Directory.Build.props.user after you copy/rename this template -->
        <DeployToPlugins Condition="'$(DeployToPlugins)' == ''">true</DeployToPlugins>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Package'">
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(TarkovBepInExDir)\core\0Harmony.dll" Private="false"/>
        <Reference Include="BepInEx" HintPath="$(TarkovBepInExDir)\core\BepInEx.dll" Private="false"/>
        <Reference Include="spt-common" HintPath="$(TarkovPluginsDir)\spt\spt-common.dll" Private="false"/>
        <Reference Include="spt-reflection" HintPath="$(TarkovPluginsDir)\spt\spt-reflection.dll" Private="false"/>
        <Reference Include="Assembly-CSharp" HintPath="$(TarkovManagedDir)\Assembly-CSharp.dll" Private="false"/>
        <Reference Include="Newtonsoft.Json" HintPath="$(TarkovManagedDir)\Newtonsoft.Json.dll" Private="false"/>
        <Reference Include="Comfort" HintPath="$(TarkovManagedDir)\Comfort.dll" Private="false"/>
        <Reference Include="Comfort.Unity" HintPath="$(TarkovManagedDir)\Comfort.Unity.dll" Private="false"/>
        <Reference Include="Sirenix.Serialization" HintPath="$(TarkovManagedDir)\Sirenix.Serialization.dll" Private="false"/>
        <Reference Include="Sirenix.Utilities" HintPath="$(TarkovManagedDir)\Sirenix.Utilities.dll" Private="false"/>
        <Reference Include="Unity.TextMeshPro" HintPath="$(TarkovManagedDir)\Unity.TextMeshPro.dll" Private="false"/>
        <Reference Include="UnityEngine" HintPath="$(TarkovManagedDir)\UnityEngine.dll" Private="false"/>
        <Reference Include="UnityEngine.UI" HintPath="$(TarkovManagedDir)\UnityEngine.UI.dll" Private="false"/>
        <Reference Include="UnityEngine.UIModule" HintPath="$(TarkovManagedDir)\UnityEngine.UIModule.dll" Private="false"/>
        <Reference Include="UnityEngine.CoreModule" HintPath="$(TarkovManagedDir)\UnityEngine.CoreModule.dll" Private="false"/>
        <Reference Include="UnityEngine.IMGUIModule" HintPath="$(TarkovManagedDir)\UnityEngine.IMGUIModule.dll" Private="false"/>
        <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(TarkovManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false"/>
        <Reference Include="Unity.VectorGraphics" HintPath="$(MSBuildProjectDirectory)\libs\Unity.VectorGraphics.dll" Private="false"/>
        <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(TarkovManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="docs\**"/>
        <Compile Remove="assets\**"/>
        <Compile Remove="Package\**"/>
        <Compile Remove="certs\**"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="docs\**"/>
        <EmbeddedResource Remove="assets\**"/>
        <EmbeddedResource Remove="Package\**"/>
        <EmbeddedResource Remove="certs\**"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="docs\**"/>
        <None Remove="assets\**"/>
        <None Remove="README.md"/>
        <None Remove="README_HUB.md"/>
        <None Remove="TEMPLATE-ATTRIBUTION.md"/>
        <None Remove="Package\**"/>
        <None Remove="certs\**"/>
        <None Include="Directory.Build.props.user" />
    </ItemGroup>

    <Target Name="IncrementPatchVersion"
            BeforeTargets="PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true' AND '$(IncrementVersionOnBuild)' == 'true'">
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
              ConsoleToMSBuild="true"
              StandardOutputImportance="low"
              Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\IncrementVersion.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;">
            <Output TaskParameter="ConsoleOutput" ItemName="_IncrementVersionOutput"/>
        </Exec>
        <PropertyGroup>
            <Version>@(_IncrementVersionOutput)</Version>
            <AssemblyVersion>$(Version)</AssemblyVersion>
            <FileVersion>$(Version)</FileVersion>
        </PropertyGroup>
        <Message Importance="high" Text="Built version $(Version) (patch auto-incremented)."/>
    </Target>

    <Target Name="ValidateTarkovInstall">        
        <Message Importance="high" Text="Managed dir: [$(TarkovManagedDir)] exists=$([System.IO.File]::Exists('$(TarkovManagedDir)\Assembly-CSharp.dll'))"/>
        <Error
            Condition="!Exists('$(TarkovManagedDir)\Assembly-CSharp.dll')"
            Text="EFT assemblies not found. Set TarkovDir in Directory.Build.props (current: $(TarkovDir))."/>
        <Error
            Condition="!Exists('$(TarkovBepInExDir)\core\BepInEx.dll')"
            Text="BepInEx not found. Set TarkovDir in Directory.Build.props (current: $(TarkovDir))."/>
    </Target>

    <PropertyGroup>
        <PluginDir>$(TarkovPluginsDir)\$(AssemblyName)</PluginDir>
        <ConfigFilePath>$(TarkovBepInExDir)\config\com.softwyx.careerlog.cfg</ConfigFilePath>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <!-- Set DeployToPlugins=false in Directory.Build.props.user to skip. -->
    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(DeployToPlugins)'=='true'">

        <PropertyGroup Condition="Exists('$(TarkovPluginsDir)') and Exists('$(ConfigFilePath)')">
            <_HadConfig>true</_HadConfig>
        </PropertyGroup>

        <!-- Create plugin directory -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="Exists('$(TarkovPluginsDir)')"/>

        <MakeDir
            Directories="$(PluginDir)"
            Condition="Exists('$(TarkovPluginsDir)')"/>

        <Message
            Importance="high"
            Text="Created plugin directory: $(PluginDir)"
            Condition="Exists('$(TarkovPluginsDir)')"/>

        <!-- Deploy DLL -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)')"/>

        <Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="$(PluginDir)"
            SkipUnchangedFiles="true"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)')"/>

        <ItemGroup
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)') and Exists('$(MSBuildProjectDirectory)\assets')">
            <_AssetFiles Include="$(MSBuildProjectDirectory)\assets\**\*"/>
        </ItemGroup>

        <Copy
            SourceFiles="@(_AssetFiles)"
            DestinationFiles="@(_AssetFiles->'$(PluginDir)\assets\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)') and '@(_AssetFiles)' != ''"/>

        <ItemGroup
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)') and Exists('$(MSBuildProjectDirectory)\locales')">
            <_LocaleFiles Include="$(MSBuildProjectDirectory)\locales\**\*"/>
        </ItemGroup>

        <Copy
            SourceFiles="@(_LocaleFiles)"
            DestinationFiles="@(_LocaleFiles->'$(PluginDir)\locales\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)') and '@(_LocaleFiles)' != ''"/>

        <!-- Deploy Unity.VectorGraphics.dll to Managed folder -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovManagedDir)') and Exists('$(MSBuildProjectDirectory)\libs\Unity.VectorGraphics.dll')"/>

        <Copy
            SourceFiles="$(MSBuildProjectDirectory)\libs\Unity.VectorGraphics.dll"
            DestinationFolder="$(TarkovManagedDir)"
            SkipUnchangedFiles="true"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovManagedDir)') and Exists('$(MSBuildProjectDirectory)\libs\Unity.VectorGraphics.dll')"/>

        <Message
            Importance="high"
            Text="Deployed Unity.VectorGraphics.dll -> $(TarkovManagedDir)"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovManagedDir)') and Exists('$(MSBuildProjectDirectory)\libs\Unity.VectorGraphics.dll')"/>

        <Message
            Importance="high"
            Text="Deployed $(TargetFileName) -> $(PluginDir)"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)')"/>

        <!-- Deploy PDB only for Debug -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="
            '$(Configuration)' == 'Debug'
            and Exists('$(TarkovPluginsDir)')
            and Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Copy
            SourceFiles="$(TargetDir)$(TargetName).pdb"
            DestinationFolder="$(PluginDir)"
            SkipUnchangedFiles="false"
            Condition="
            '$(Configuration)' == 'Debug'
            and Exists('$(TarkovPluginsDir)')
            and Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Message
            Importance="high"
            Text="Deployed debug symbols: $(TargetName).pdb"
            Condition="
            '$(Configuration)' == 'Debug'
            and Exists('$(TarkovPluginsDir)')
            and Exists('$(TargetDir)$(TargetName).pdb')"/>

        <!-- Remove old plugin copy -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)\$(TargetFileName)')"/>

        <Delete
            Files="$(TarkovPluginsDir)\$(TargetFileName)"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)\$(TargetFileName)')"/>

        <Message
            Importance="high"
            Text="Removed old plugin copy: $(TarkovPluginsDir)\$(TargetFileName)"
            Condition="'$(DeployToPlugins)'=='true' and Exists('$(TarkovPluginsDir)\$(TargetFileName)')"/>

        <!-- Remove config -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="'$(_HadConfig)' == 'true'"/>

        <Delete
            Files="$(ConfigFilePath)"
            Condition="Exists('$(TarkovPluginsDir)') and Exists('$(ConfigFilePath)')"/>

        <Message
            Importance="high"
            Text="Removed config (fresh defaults on next launch): $(ConfigFilePath)"
            Condition="'$(_HadConfig)' == 'true'"/>

        <!-- Missing plugins dir -->
        <Message
            Importance="high"
            Text="========================================================================="
            Condition="!Exists('$(TarkovPluginsDir)')"/>

        <Warning
            Text="Plugins folder not found: $(TarkovPluginsDir)"
            Condition="!Exists('$(TarkovPluginsDir)')"/>

    </Target>

    <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)'=='Package'">
        <Exec Command="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;$(ProjectDir)\scripts\package.ps1&quot;"/>
    </Target>
</Project>
